<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:heroshika_client"
             x:Class="heroshika_client.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:InvertedBoolConverter xmlns:converters="clr-namespace:heroshika_client.Converters" x:Key="InvertedBoolConverter" />
            <converters:StatusToColorConverter xmlns:converters="clr-namespace:heroshika_client.Converters" x:Key="StatusToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
