<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="heroshika_client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:heroshika_client.Views"
    Title="HEROSHIKO AI Studio"
    BackgroundColor="{StaticResource DarkBackground}"
    Shell.BackgroundColor="{StaticResource Surface}"
    Shell.ForegroundColor="{StaticResource White}"
    Shell.TitleColor="{StaticResource Primary}"
    Shell.TabBarBackgroundColor="{StaticResource Surface}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource Gray500}"
    Shell.TabBarTitleColor="{StaticResource Primary}">

    <TabBar>
        <Tab Title="Студия" Icon="tab_studio.png">
            <ShellContent
                Title="Каталог стилей"
                ContentTemplate="{DataTemplate views:PresetsPage}"
                Route="PresetsPage" />
        </Tab>

        <Tab Title="Настройки" Icon="tab_settings.png">
            <ShellContent
                Title="Настройки сервера"
                ContentTemplate="{DataTemplate views:SettingsPage}"
                Route="SettingsPage" />
        </Tab>
    </TabBar>

</Shell>
