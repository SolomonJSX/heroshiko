<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:heroshika_client.ViewModels"
             x:Class="heroshika_client.Views.GenerationTuningPage"
             x:DataType="vm:GenerationTuningViewModel"
             BackgroundColor="{StaticResource DarkBackground}"
             Shell.NavBarIsVisible="False"
             Title="Настройка образа">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">
            <!-- Step Tracker -->
            <Border BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource CardBorder}"
                    StrokeShape="RoundRectangle 12"
                    Padding="14, 12">
                <Grid ColumnDefinitions="Auto, *">
                    <Button Grid.Column="0"
                            Text="⬅"
                            FontSize="18"
                            TextColor="{StaticResource Primary}"
                            BackgroundColor="Transparent"
                            Command="{Binding GoBackCommand}"
                            VerticalOptions="Center"
                            Padding="0"
                            WidthRequest="36"
                            HeightRequest="36"
                            Margin="0, 0, 8, 0" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="ШАГ 3 ИЗ 4: КАСТОМИЗАЦИЯ"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}" />
                        <Label Text="{Binding PresetTitle}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Hair Section -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    Stroke="{StaticResource CardBorder}"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="💇 Управление прической"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />

                    <!-- Hair Mode Selector (3 options) -->
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="👤 Моя"
                                FontSize="12"
                                HeightRequest="40"
                                Padding="0"
                                CornerRadius="8"
                                BorderColor="{StaticResource CardBorder}"
                                BorderWidth="1"
                                BackgroundColor="{StaticResource Surface}"
                                TextColor="{StaticResource White}"
                                Command="{Binding SetHairModeCommand}"
                                CommandParameter="keep" />
                        <Button Grid.Column="1"
                                Text="✂️ Сменить"
                                FontSize="12"
                                HeightRequest="40"
                                Padding="0"
                                CornerRadius="8"
                                BorderColor="{StaticResource CardBorder}"
                                BorderWidth="1"
                                BackgroundColor="{StaticResource Surface}"
                                TextColor="{StaticResource White}"
                                Command="{Binding SetHairModeCommand}"
                                CommandParameter="change" />
                        <Button Grid.Column="2"
                                Text="🎨 Из стиля"
                                FontSize="12"
                                HeightRequest="40"
                                Padding="0"
                                CornerRadius="8"
                                BorderColor="{StaticResource CardBorder}"
                                BorderWidth="1"
                                BackgroundColor="{StaticResource Surface}"
                                TextColor="{StaticResource White}"
                                Command="{Binding SetHairModeCommand}"
                                CommandParameter="preset" />
                    </Grid>

                    <!-- Hair style & color pickers if "change" is active -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsChangeHair}">
                        <Label Text="Желаемый стиль стрижки:" FontSize="12" TextColor="{StaticResource Gray300}" />
                        <Picker ItemsSource="{Binding HairStyles}"
                                SelectedItem="{Binding SelectedHairStyle}"
                                TextColor="{StaticResource White}"
                                BackgroundColor="{StaticResource Surface}"
                                TitleColor="{StaticResource Gray400}" />

                        <Label Text="Желаемый цвет волос:" FontSize="12" TextColor="{StaticResource Gray300}" />
                        <Picker ItemsSource="{Binding HairColors}"
                                SelectedItem="{Binding SelectedHairColor}"
                                TextColor="{StaticResource White}"
                                BackgroundColor="{StaticResource Surface}"
                                TitleColor="{StaticResource Gray400}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Body & Ethnicity Section -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    Stroke="{StaticResource CardBorder}"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="👤 Анатомия и Этнотип"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />

                    <Label Text="Пол (Гендер):" FontSize="12" TextColor="{StaticResource Gray300}" />
                    <Picker ItemsSource="{Binding Genders}"
                            SelectedItem="{Binding SelectedGenderOption}"
                            ItemDisplayBinding="{Binding Title}"
                            TextColor="{StaticResource White}"
                            BackgroundColor="{StaticResource Surface}" />

                    <Label Text="Этнотип лица:" FontSize="12" TextColor="{StaticResource Gray300}" />
                    <Picker ItemsSource="{Binding Ethnicities}"
                            SelectedItem="{Binding SelectedEthnicityOption}"
                            ItemDisplayBinding="{Binding Title}"
                            TextColor="{StaticResource White}"
                            BackgroundColor="{StaticResource Surface}" />

                    <Label Text="Телосложение:" FontSize="12" TextColor="{StaticResource Gray300}" />
                    <Picker ItemsSource="{Binding BodyBuilds}"
                            SelectedItem="{Binding SelectedBodyBuildOption}"
                            ItemDisplayBinding="{Binding Title}"
                            TextColor="{StaticResource White}"
                            BackgroundColor="{StaticResource Surface}" />
                </VerticalStackLayout>
            </Border>

            <!-- Advanced Settings Accordion -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    Stroke="{StaticResource CardBorder}"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="⚙️ Расширенные настройки нейросети"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="{Binding AdvancedToggleText}"
                                TextColor="{StaticResource Primary}"
                                FontAttributes="Bold"
                                FontSize="12"
                                BackgroundColor="Transparent"
                                HeightRequest="36"
                                Padding="8, 0"
                                Command="{Binding ToggleAdvancedCommand}" />
                    </Grid>

                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowAdvanced}">
                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" />

                        <!-- Face Strength Slider -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Сходство лица IP-Adapter (реком. 0.35–0.45):" FontSize="11" TextColor="{StaticResource Gray300}" />
                                <Label Grid.Column="1" Text="{Binding FaceStrength, StringFormat='{0:F2}'}" FontSize="11" TextColor="{StaticResource Primary}" />
                            </Grid>
                            <Slider Minimum="0.2" Maximum="1.0" Value="{Binding FaceStrength}"
                                    MinimumTrackColor="{StaticResource Primary}"
                                    ThumbColor="{StaticResource Primary}" />
                        </VerticalStackLayout>

                        <!-- Fidelity Weight Slider -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Сохранение черт CodeFormer (реком. 0.80):" FontSize="11" TextColor="{StaticResource Gray300}" />
                                <Label Grid.Column="1" Text="{Binding FidelityWeight, StringFormat='{0:F2}'}" FontSize="11" TextColor="{StaticResource Primary}" />
                            </Grid>
                            <Slider Minimum="0.4" Maximum="1.0" Value="{Binding FidelityWeight}"
                                    MinimumTrackColor="{StaticResource Primary}"
                                    ThumbColor="{StaticResource Primary}" />
                        </VerticalStackLayout>

                        <!-- Steps Slider -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Шаги инференса (DPM++ 2M Karras):" FontSize="11" TextColor="{StaticResource Gray300}" />
                                <Label Grid.Column="1" Text="{Binding Steps}" FontSize="11" TextColor="{StaticResource Primary}" />
                            </Grid>
                            <Slider Minimum="15" Maximum="40" Value="{Binding Steps}"
                                    MinimumTrackColor="{StaticResource Primary}"
                                    ThumbColor="{StaticResource Primary}" />
                        </VerticalStackLayout>

                        <!-- Toggles -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0, 4, 0, 0">
                            <Label Text="Предварительное улучшение (Pre-Enhance)" FontSize="12" TextColor="{StaticResource White}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ApplyPreEnhance}" OnColor="{StaticResource Primary}" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Перенос биометрии INSwapper" FontSize="12" TextColor="{StaticResource White}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ApplyFaceSwap}" OnColor="{StaticResource Primary}" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="HD-реставрация текстуры кожи CodeFormer" FontSize="12" TextColor="{StaticResource White}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ApplyFaceRestore}" OnColor="{StaticResource Primary}" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Кинематографичное зерно Film Grain" FontSize="12" TextColor="{StaticResource White}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ApplyFilmGrain}" OnColor="{StaticResource Primary}" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Launch Button -->
            <Button Text="⚡ Сгенерировать фотосессию ➔"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource PrimaryDarkText}"
                    CornerRadius="12"
                    HeightRequest="52"
                    Command="{Binding StartPhotoshootCommand}"
                    Margin="0, 10, 0, 20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
