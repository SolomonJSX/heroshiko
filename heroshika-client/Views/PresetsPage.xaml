<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:heroshika_client.ViewModels"
             xmlns:models="clr-namespace:heroshika_client.Models"
             xmlns:converters="clr-namespace:heroshika_client.Converters"
             x:Class="heroshika_client.Views.PresetsPage"
             x:DataType="vm:PresetsViewModel"
             BackgroundColor="{StaticResource DarkBackground}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- Top Bar Header -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="1"
                Padding="16, 12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- App Logo & Branding -->
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Image Source="heroshiko_icon.png" WidthRequest="36" HeightRequest="36" Aspect="AspectFit"/>
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="HEROSHIKO"
                               FontAttributes="Bold"
                               FontSize="17"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="AI Photo Studio"
                               FontSize="11"
                               TextColor="{StaticResource Secondary}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Server Status Indicator -->
                <Border Grid.Column="1"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="#182234"
                        Stroke="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16"
                        Padding="12, 6">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <BoxView WidthRequest="8" HeightRequest="8"
                                 CornerRadius="4"
                                 Color="{Binding IsServerOnline, Converter={StaticResource StatusToColorConverter}}"
                                 VerticalOptions="Center" />
                        <Label Text="{Binding ServerStatusText}"
                               FontSize="11"
                               TextColor="{StaticResource Gray300}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Settings Button -->
                <Button Grid.Column="2"
                        Text="⚙️"
                        FontSize="18"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Gray300}"
                        Command="{Binding OpenSettingsCommand}"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Main Scrollable Content -->
        <RefreshView Grid.Row="1"
                     Command="{Binding LoadPresetsCommand}"
                     IsRefreshing="{Binding IsBusy}"
                     RefreshColor="{StaticResource Primary}">
            <ScrollView Padding="16, 20">
                <VerticalStackLayout Spacing="20">
                    <!-- Title Section -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Выберите стиль фотосессии"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}" />
                        <Label Text="Нейросеть адаптирует освещение, одежду и позу под вашу биометрию"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}" />
                    </VerticalStackLayout>

                    <!-- Presets List using BindableLayout (надежно работает на Android без багов высоты CollectionView) -->
                    <VerticalStackLayout Spacing="16"
                                         BindableLayout.ItemsSource="{Binding Presets}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PresetResponse">
                                <Border BackgroundColor="#182032"
                                        Stroke="{StaticResource CardBorder}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PresetsViewModel}}, Path=SelectPresetCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="0">
                                        <!-- Cover Poster Image with Tag -->
                                        <Grid HeightRequest="210" BackgroundColor="#1E293B">
                                            <Image Source="{Binding DisplayCoverSource}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="210"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill" />

                                            <!-- Tag Badge -->
                                            <Border HorizontalOptions="Start"
                                                    VerticalOptions="Start"
                                                    Margin="12"
                                                    BackgroundColor="#D00B0E17"
                                                    Stroke="{StaticResource Primary}"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="8, 4">
                                                <Label Text="{Binding Id}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}" />
                                            </Border>
                                        </Grid>

                                        <!-- Card Info Content -->
                                        <VerticalStackLayout Padding="16"
                                                             Spacing="8"
                                                             BackgroundColor="#182032">
                                            <Label Text="{Binding Title}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource White}" />

                                            <Label Text="{Binding Prompt}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource Gray400}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2" />

                                            <Grid ColumnDefinitions="*, Auto" Margin="0, 4, 0, 0">
                                                <Label Text="Студийный свет • INSwapper • CodeFormer"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Secondary}"
                                                       VerticalOptions="Center" />

                                                <Button Grid.Column="1"
                                                        Text="Выбрать ➔"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        BackgroundColor="{StaticResource Primary}"
                                                        TextColor="{StaticResource PrimaryDarkText}"
                                                        CornerRadius="8"
                                                        HeightRequest="36"
                                                        Padding="14, 0"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PresetsViewModel}}, Path=SelectPresetCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
